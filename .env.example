# Copy to .env and fill in. .env is gitignored; never commit keys.

# Required: firms and advisors run on Claude Haiku 5.5.
ANTHROPIC_API_KEY=

# Optional: robustness arm on a second model family (DeepSeek API, OpenAI-compatible).
DEEPSEEK_API_KEY=

# Optional: only if a robustness model is reached through OpenRouter instead.
OPENROUTER_API_KEY=

# Optional: third model lineage (OpenAI, free daily tokens with data sharing on mini models).
OPENAI_API_KEY=
